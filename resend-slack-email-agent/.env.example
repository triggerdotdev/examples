# Your Trigger.dev project ref (from the project settings page in the dashboard)
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxxxxxxxxxxxxxxx

# Resend API key with access to Inboxes (reads threads, sends replies)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Slack app's Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxx

# The one Slack user the bot DMs and listens to (Slack profile > ... > Copy member ID)
SLACK_USER_ID=U0123456789

# Vercel AI Gateway key, used by the AI SDK to draft replies
AI_GATEWAY_API_KEY=

# Only emails from these sender domains get drafted (comma-separated).
# Leave empty to draft a reply to every email.
ALLOWED_SENDER_DOMAINS=yourcompany.com

# Optional: a different AI Gateway model id
# INBOX_BOT_MODEL=anthropic/claude-opus-5.5
