# Trigger.dev — Dashboard → API keys (dev key for local, prod key to deploy)
TRIGGER_SECRET_KEY=

# Your Trigger.dev project ref (proj_...), also set in trigger.config.ts
TRIGGER_PROJECT_REF=

# The chat agent's model call. Named VOICE_ANTHROPIC_API_KEY (not
# ANTHROPIC_API_KEY) so it can't be picked up by other tooling.
VOICE_ANTHROPIC_API_KEY=

# Both voice sockets (streaming STT + streaming TTS). Never reaches the
# browser — the server mints short-lived single-use tokens from it.
ELEVENLABS_API_KEY=

# Optional: override the default ElevenLabs voice.
# NEXT_PUBLIC_TTS_VOICE_ID=
