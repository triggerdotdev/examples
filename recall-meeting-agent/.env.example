# Trigger.dev tasks (src/trigger). Copy to .env for `pnpm dev`.
# In production, set these on your Trigger.dev environment (Environment variables page).

# Vercel AI Gateway key, used for the agent's model calls (Claude) through the AI SDK.
AI_GATEWAY_API_KEY=

# Resend API key, used to read inbox emails and save reply drafts.
RESEND_API_KEY=

# Recall.ai API key and the region your Recall workspace is in (us-west-2, us-east-1, eu-central-1 or ap-northeast-1).
RECALL_API_KEY=
RECALL_REGION=us-west-2

# Public URL of the bot page you deploy from web/ (the Recall bot loads it as its camera).
BOT_PAGE_URL=https://your-bot-page.example.com

# Optional: if web/ is behind Vercel Deployment Protection, its "Protection Bypass for Automation" secret.
VERCEL_BYPASS_SECRET=

# Optional: what the agent is called (also its wake word, "Hey Scout") and the company it works for.
AGENT_NAME=Scout
COMPANY_NAME=Acme
