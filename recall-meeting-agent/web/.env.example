# The bot page (web/). Set these on wherever you host it.

# Vercel AI Gateway key, used for the bot's voice (text to speech).
AI_GATEWAY_API_KEY=

# Recall.ai API key and region, used to start the bot's screenshare when it speaks.
RECALL_API_KEY=
RECALL_REGION=us-west-2

# Optional: if this page is behind Vercel Deployment Protection, its "Protection Bypass for Automation" secret,
# so the screenshare page gets past it too. (Vercel also exposes it as VERCEL_AUTOMATION_BYPASS_SECRET.)
VERCEL_BYPASS_SECRET=
