# Trigger.dev project reference, for example proj_abc123.
TRIGGER_PROJECT_REF=

# Create a dedicated, revocable key in your BRAINIALL account.
# Never commit the value or include it in a task payload.
BRAINIALL_API_KEY=

# Exact HTTPS hostnames from which this task may download audio.
# Use a comma-separated list without schemes, paths, ports, or wildcards.
# Example: media.example.com,my-bucket.s3.us-east-1.amazonaws.com
AUDIO_SOURCE_HOSTS=
